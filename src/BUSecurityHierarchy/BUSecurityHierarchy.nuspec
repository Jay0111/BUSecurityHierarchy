<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
	<metadata>
		<id>Jay0111.XrmToolBox.BUSecurityHierarchy</id>
		<version>1.2026.5.1</version>
		<title>BU Security Hierarchy Viewer</title>
		<authors>Thota Jayadev</authors>
		<owners>Thota Jayadev</owners>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<description>Visualize Dynamics 365 Business Unit hierarchy with Teams and Users. Drill down from BU → Teams → Users in an interactive tree view.</description>
		<summary>View BU → Team → User security hierarchy in Dynamics 365</summary>
		<releaseNotes>
			v1.2026.5.1 - Initial release
			- Visualize Business Unit hierarchy in tree view
			- Drill down from BU → Teams → Users
			- View team types (Owner, Access, AAD Security, AAD Office)
			- Display user email addresses
			- Expand/collapse hierarchy controls
			- Clean, intuitive interface
		</releaseNotes>
		<language>en-US</language>
		<projectUrl>https://github.com/Jay0111/BUSecurityHierarchy</projectUrl>
		<repository type="git" url="https://github.com/Jay0111/BUSecurityHierarchy.git" />
		<icon>Resources/icon.png</icon>
		<readme>docs/README.md</readme>
		<license type="expression">MIT</license>
		<iconUrl>https://raw.githubusercontent.com/Jay0111/BUSecurityHierarchy/main/icon.png</iconUrl>
		<tags>XrmToolBox Dynamics365 Dataverse BusinessUnit Security Hierarchy Teams Users PowerPlatform</tags>
		<dependencies>
				<dependency id="XrmToolBoxPackage" version="1.2023.10.67" />
		</dependencies>
	</metadata>
	<files>
		<file src="bin\Release\BUSecurityHierarchy.dll" target="lib\net48\Plugins\BUSecurityHierarchy.dll" />
		<file src="Resources/icon.png" target="Resources/icon.png" />
		<file src="..\..\README.md" target="docs\README.md" />
	</files>
</package>
