<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
	<metadata>
		<id>Jay0111.XrmToolBox.BUSecurityHierarchy</id>
		<version>1.0.21</version>
		<title>BU Security Hierarchy Viewer</title>
		<authors>Thota Jayadev</authors>
		<owners>Thota Jayadev</owners>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<description>Visualize Dynamics 365 Business Unit hierarchy with Teams and Users. Drill down from BU → Teams → Users in an interactive tree view.</description>
		<summary>View BU → Team → User security hierarchy in Dynamics 365</summary>
		<releaseNotes>
			v1.0.21 - Updated version
			v1.0.20 - Updated tool logo
			v1.0.19 - updated dependency
			v1.0.18 - Added iconUrl for XrmToolBox portal compatibility
			v1.0.17 - Updated target path
			v1.0.16 - Added XrmToolBox dependency
		</releaseNotes>
		<language>en-US</language>
		<projectUrl>https://github.com/Jay0111/BUSecurityHierarchy</projectUrl>
		<icon>Resources\icon.png</icon>
		<readme>docs\README.md</readme>
		<license type="expression">MIT</license>
		<iconUrl>https://raw.githubusercontent.com/Jay0111/BUSecurityHierarchy/main/src/BUSecurityHierarchy/Resources/icon.png</iconUrl>
		<tags>XrmToolBox Dynamics365 Dataverse BusinessUnit Security Hierarchy Teams Users PowerPlatform</tags>
		<dependencies>
			<group targetFramework=".NETFramework4.8">
				<dependency id="XrmToolBox" version="[1.2023.10.67,)" />
			</group>
		</dependencies>
	</metadata>
	<files>
		<file src="bin\Release\BUSecurityHierarchy.dll" target="lib\net48\Plugins\BUSecurityHierarchy.dll" />
		<file src="Resources\icon.png" target="Resources" />
		<file src="..\..\README.md" target="docs\README.md" />
	</files>
</package>
